# Target email inbox where all client enquiries will be delivered
TARGET_EMAIL=canadianclassicimmigration@gmail.com

# -----------------------------------------------------------------
# OPTION 1: Gmail SMTP (Direct sending via your Gmail account)
# -----------------------------------------------------------------
# 1. Ensure 2-Step Verification is turned ON for canadianclassicimmigration@gmail.com
# 2. Visit https://myaccount.google.com/apppasswords to create a 16-character App Password
# 3. Paste the credentials below:
EMAIL_USER=canadianclassicimmigration@gmail.com
EMAIL_PASS=your-16-char-app-password

# (Optional: If using custom domain SMTP instead of Gmail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# -----------------------------------------------------------------
# OPTION 2: Resend (Alternative modern email API)
# -----------------------------------------------------------------
# 1. Get an API key from https://resend.com
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Canadian Classic Immigration <onboarding@resend.dev>
